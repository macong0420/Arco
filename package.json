{
  "name": "arco-browser",
  "version": "0.1.0",
  "description": "Arco — Arc 风格的 Chromium macOS 浏览器",
  "main": "src/main.js",
  "private": true,
  "license": "Apache-2.0",
  "author": "Arco contributors",
  "scripts": {
    "start": "npm run build:native && electron .",
    "test": "node --test test/core.test.js test/sync.test.js test/browsers.test.js test/crx.test.js",
    "test:e2e": "npm run build:native && node --test test/e2e.test.js",
    "build:native": "sh scripts/build-native.sh",
    "icon": "swift scripts/make-icon.swift",
    "pack": "npm run build:native && electron-builder --mac dir --arm64 && sh scripts/sign-local.sh",
    "capture": "npm run test:e2e"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.65.0"
  },
  "build": {
    "appId": "com.arco.browser",
    "productName": "Arco",
    "asar": true,
    "files": ["src/**/*", "resources/**/*", "package.json", "LICENSE", "NOTICE", "README.md"],
    "extraResources": [
      { "from": "native/ArcoVault", "to": "native/ArcoVault" }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "15.4",
      "target": [{ "target": "dir", "arch": ["arm64"] }],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSUserNotificationUsageDescription": "Arco 显示网站通知。",
        "NSCameraUsageDescription": "网站需要你的许可才能使用相机。",
        "NSMicrophoneUsageDescription": "网站需要你的许可才能使用麦克风。"
      }
    },
    "directories": { "output": "dist" }
  },
  "dependencies": {
    "electron-chrome-extensions": "4.10.0"
  }
}
